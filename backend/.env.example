# Copia este archivo a .env y ajusta los valores segun tu entorno.

# Django
SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL (coincide con docker-compose.yml)
DB_NAME=experticia_demo
DB_USER=experticia
DB_PASSWORD=experticia
DB_HOST=localhost
DB_PORT=5432

# Para desarrollo rapido sin PostgreSQL (no recomendado para la demo):
# USE_SQLITE=1

# CORS: origen del frontend Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Cliente al que se presenta la demo (parametrizable)
DEMO_CLIENT_NAME=BHP · Faena Spence
